<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- background color -->
    <solid android:color="#FFFFFF" />

    <!-- rounded corners -->
    <corners android:radius="10dp" />

    <!-- light gray border -->
    <stroke
        android:width="1dp"
        android:color="#CCCCCC" />

    <!-- inner padding -->
    <padding
        android:left="10dp"
        android:top="8dp"
        android:right="10dp"
        android:bottom="8dp" />
</shape>